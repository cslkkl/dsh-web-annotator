+    textarea::placeholder{color:${options.dark ? '#aaaeb5' : '#888e96'};opacity:1}
+    .options{position:static;box-shadow:none;flex:1;min-height:0;overflow:auto;font-size:14px;line-height:22px;scrollbar-width:thin}
