+  return (
+    object(value) &&
+    (value.intent === 'comment' || value.intent === 'question') &&
+    typeof value.dark === 'boolean' &&
+    object(value.copy) &&
+    [
+      'select',
+      'comment',
+      'question',
+      'placeholder',
+      'settings',
+      'save',
+      'cancel',
+      'parent',
+      'child',
+      'targetGone',
+      'empty',
+      'region',
+      'point',
+      'interact',
+      'color',
+      'background',
+      'opacity',
+      'font',
+      'fontSize',
+      'fontWeight',
+      'spacing',
+      'elementOnly',
+      'invalidStyle',
+      'applyStyles',
+      'styleHint',
+    ].every((key) => string(value.copy && object(value.copy) ? value.copy[key] : null, 500))
+  );
+}
